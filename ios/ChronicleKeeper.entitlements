<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iPhone and iPad app's entitlements. $(ICLOUD_CONTAINER) is a build setting (Signing.xcconfig). Xcode signs
     debug builds for iCloud's Development environment and App Store builds for Production. -->
<plist version="1.0">
<dict>
    <!-- CKSyncEngine's silent pushes, so settings synced from another device arrive in the background. -->
    <key>aps-environment</key>
    <string>development</string>
    <!-- The container boons and chronicles sync through in iCloud Drive, and settings sync through via CloudKit. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>$(ICLOUD_CONTAINER)</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
        <string>CloudDocuments</string>
    </array>
    <!-- FileManager.url(forUbiquityContainerIdentifier: nil) takes the first of these for the PDFs. -->
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>$(ICLOUD_CONTAINER)</string>
    </array>
</dict>
</plist>
